DATABASE_URL="postgres://biometric:biometric_dev_only@localhost:5544/biometric?sslmode=disable"

# Generate with: openssl rand -base64 32
TEMPLATE_ENCRYPTION_KEY=

# Generate all three with ./scripts/gen-certs.sh from the repo root,
# paths below are relative to go-client/, matching where the CLI runs from
MATCHER_CLIENT_CERT_FILE=../certs/client-cert.pem
MATCHER_CLIENT_KEY_FILE=../certs/client-key.pem
MATCHER_CA_FILE=../certs/ca-cert.pem
MATCHER_REVOKED_SERIALS_FILE=../certs/revoked-serials.txt